<?xml version="1.0" encoding="UTF-8"?>
<!-- ComplexParamVol : graded sensors (rmax varies per copy)
     testReplica expected result: Param Volume / Complex (daughters differ) -->
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define/>
  <materials>
    <material name="Vacuum" Z="1"><D value="1e-25" unit="g/cm3"/><atom value="1.008"/></material>
    <material name="Silicon" Z="14"><D value="2.33" unit="g/cm3"/><atom value="28.09"/></material>
  </materials>
  <solids>
    <tube name="rSensor42" rmin="8" rmax="42.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <tube name="rSensor44" rmin="8" rmax="44.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <tube name="rSensor46" rmin="8" rmax="46.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <tube name="rSensor48" rmin="8" rmax="48.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <tube name="rSensor50" rmin="8" rmax="50.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <tube name="rSensor52" rmin="8" rmax="52.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <tube name="rSensor54" rmin="8" rmax="54.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <tube name="rSensor56" rmin="8" rmax="56.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <box name="veloBox" x="160" y="160" z="1600" lunit="mm"/>
    <box name="worldBox" x="240" y="240" z="2000" lunit="mm"/>
  </solids>
  <structure>
    <volume name="lvRSensor42"><materialref ref="Silicon"/><solidref ref="rSensor42"/></volume>
    <volume name="lvRSensor44"><materialref ref="Silicon"/><solidref ref="rSensor44"/></volume>
    <volume name="lvRSensor46"><materialref ref="Silicon"/><solidref ref="rSensor46"/></volume>
    <volume name="lvRSensor48"><materialref ref="Silicon"/><solidref ref="rSensor48"/></volume>
    <volume name="lvRSensor50"><materialref ref="Silicon"/><solidref ref="rSensor50"/></volume>
    <volume name="lvRSensor52"><materialref ref="Silicon"/><solidref ref="rSensor52"/></volume>
    <volume name="lvRSensor54"><materialref ref="Silicon"/><solidref ref="rSensor54"/></volume>
    <volume name="lvRSensor56"><materialref ref="Silicon"/><solidref ref="rSensor56"/></volume>
    <volume name="lvVelo">
      <materialref ref="Vacuum"/>
      <solidref ref="veloBox"/>
      <physvol name="pv_00"><volumeref ref="lvRSensor42"/><position name="p_00" x="0" y="0" z="-175.0" unit="mm"/></physvol>
      <physvol name="pv_01"><volumeref ref="lvRSensor44"/><position name="p_01" x="0" y="0" z="-145.0" unit="mm"/></physvol>
      <physvol name="pv_02"><volumeref ref="lvRSensor46"/><position name="p_02" x="0" y="0" z="-115.0" unit="mm"/></physvol>
      <physvol name="pv_03"><volumeref ref="lvRSensor48"/><position name="p_03" x="0" y="0" z="-85.0" unit="mm"/></physvol>
      <physvol name="pv_04"><volumeref ref="lvRSensor50"/><position name="p_04" x="0" y="0" z="-55.0" unit="mm"/></physvol>
      <physvol name="pv_05"><volumeref ref="lvRSensor52"/><position name="p_05" x="0" y="0" z="-25.0" unit="mm"/></physvol>
      <physvol name="pv_06"><volumeref ref="lvRSensor54"/><position name="p_06" x="0" y="0" z="5.0" unit="mm"/></physvol>
      <physvol name="pv_07"><volumeref ref="lvRSensor56"/><position name="p_07" x="0" y="0" z="35.0" unit="mm"/></physvol>
    </volume>
    <volume name="World">
      <materialref ref="Vacuum"/>
      <solidref ref="worldBox"/>
      <physvol name="pvVelo"><volumeref ref="lvVelo"/></physvol>
    </volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="World"/>
  </setup>
</gdml>
