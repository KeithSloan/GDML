<?xml version="1.0" encoding="UTF-8"?>
<!-- VeloTestParamVol : identical sensors, irregular spacing
     testReplica expected result: Param Volume / identical Daughters -->
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define/>
  <materials>
    <material name="Vacuum" Z="1"><D value="1e-25" unit="g/cm3"/><atom value="1.008"/></material>
    <material name="Silicon" Z="14"><D value="2.33" unit="g/cm3"/><atom value="28.09"/></material>
  </materials>
  <solids>
    <tube name="rSensor" rmin="8" rmax="42.0" z="0.3" startphi="0" deltaphi="180" aunit="deg" lunit="mm"/>
    <box name="veloBox" x="160" y="160" z="1600" lunit="mm"/>
    <box name="worldBox" x="240" y="240" z="2000" lunit="mm"/>
  </solids>
  <structure>
    <volume name="lvRSensor"><materialref ref="Silicon"/><solidref ref="rSensor"/></volume>
    <volume name="lvVelo">
      <materialref ref="Vacuum"/>
      <solidref ref="veloBox"/>
      <physvol name="pv_00"><volumeref ref="lvRSensor"/><position name="p_00" x="0" y="0" z="-200" unit="mm"/></physvol>
      <physvol name="pv_01"><volumeref ref="lvRSensor"/><position name="p_01" x="0" y="0" z="-150" unit="mm"/></physvol>
      <physvol name="pv_02"><volumeref ref="lvRSensor"/><position name="p_02" x="0" y="0" z="-120" unit="mm"/></physvol>
      <physvol name="pv_03"><volumeref ref="lvRSensor"/><position name="p_03" x="0" y="0" z="-60" unit="mm"/></physvol>
      <physvol name="pv_04"><volumeref ref="lvRSensor"/><position name="p_04" x="0" y="0" z="-20" unit="mm"/></physvol>
      <physvol name="pv_05"><volumeref ref="lvRSensor"/><position name="p_05" x="0" y="0" z="40" unit="mm"/></physvol>
      <physvol name="pv_06"><volumeref ref="lvRSensor"/><position name="p_06" x="0" y="0" z="90" unit="mm"/></physvol>
      <physvol name="pv_07"><volumeref ref="lvRSensor"/><position name="p_07" x="0" y="0" z="160" unit="mm"/></physvol>
      <physvol name="pv_08"><volumeref ref="lvRSensor"/><position name="p_08" x="0" y="0" z="240" unit="mm"/></physvol>
    </volume>
    <volume name="World">
      <materialref ref="Vacuum"/>
      <solidref ref="worldBox"/>
      <physvol name="pvVelo"><volumeref ref="lvVelo"/></physvol>
    </volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="World"/>
  </setup>
</gdml>
